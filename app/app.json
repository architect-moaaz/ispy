{
  "expo": {
    "name": "iSpy a Spy",
    "slug": "ispy-a-spy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "iSpy a Spy uses your location while you are on field duty to find your area and verify you reached a target."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#0b0f14",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "iSpy a Spy uses your location while you are on field duty to find your area and verify you reached a target.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-font"
    ]
  }
}
