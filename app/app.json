{
  "expo": {
    "name": "iSpy a Spy",
    "slug": "ispy-a-spy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/art/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "iSpy a Spy uses your location while you are on field duty to find your area and verify you reached a target.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.moaaz.ispyaspy"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07111A",
        "foregroundImage": "./assets/art/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.moaaz.ispyaspy",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/art/icon.png"
    },
    "backgroundColor": "#07111A",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "iSpy a Spy uses your location while you are on field duty to find your area and verify you reached a target.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/art/splash.jpg",
          "resizeMode": "cover",
          "backgroundColor": "#07111A"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#00F0FF",
          "defaultChannel": "orders"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "iSpy a Spy uses the camera only as a live backdrop for the AR view. Nothing is recorded or uploaded."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c19e1679-5c03-48ee-8e4f-931a33cd8352"
      }
    },
    "owner": "moaazabir",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c19e1679-5c03-48ee-8e4f-931a33cd8352"
    }
  }
}
